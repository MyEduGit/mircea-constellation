        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: 'gpt-4o', messages: [{ role: 'user', content: $json.synthesis_prompt }], max_tokens: 600 }) }}",
        "options": {},
        "timeout": 20000
      },
