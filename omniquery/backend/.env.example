# OmniQuery Backend — environment variables
# Copy this file to .env and fill in real values.
# .env is excluded from git. Never commit real keys.

OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_API_KEY
XAI_API_KEY=REPLACE_WITH_XAI_API_KEY

# Server binding — do not change to 0.0.0.0 without explicit approval
OMNIQUERY_HOST=127.0.0.1
OMNIQUERY_PORT=8741

# Provisional model ID — verify against Anthropic docs before live use.
# Override here if claude-opus-4-7 is not yet available.
CLAUDE_MODEL=claude-opus-4-7
